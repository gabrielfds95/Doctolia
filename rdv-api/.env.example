# Copier ce fichier en .env (jamais commité, voir .gitignore) et renseigner
# de vraies valeurs avant `docker compose up`.

# Secret de signature JWT — générer une valeur aléatoire d'au moins 32 caractères,
# par ex. : openssl rand -base64 32
JWT_SECRET=change-me-generate-a-real-random-secret-at-least-32-chars

# PostgreSQL
POSTGRES_DB=doctolia
POSTGRES_USER=doctolia
POSTGRES_PASSWORD=change-me
